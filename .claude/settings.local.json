{
  "permissions": {
    "allow": ["Bash(*)", "PowerShell(*)", "WebSearch"],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm *)",
      "Bash(sudo rm -rf *)",
      "Bash(mkfs* *)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(chmod -R 777 /)",
      "Bash(chown -R * /)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(git branch -D *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "PowerShell(Remove-Item -Recurse -Force *)",
      "PowerShell(rm -rf *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(Clear-Disk *)"
    ]
  }
}
