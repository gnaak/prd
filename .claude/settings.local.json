{
  "env": {
    "MAX_OUTPUT_TOKENS": "16000",
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/check-stage.ps1"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(*)", "PowerShell(*)"],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm *)",
      "Bash(sudo rm -rf *)",
      "Bash(mkfs* *)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(chmod -R 777 /)",
      "Bash(chown -R * /)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(git branch -D *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "PowerShell(Remove-Item -Recurse -Force *)",
      "PowerShell(rm -rf *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(Clear-Disk *)"
    ],
    "additionalDirectories": ["C:\\Users\\gnaaak\\AppData\\Local\\Temp"]
  }
}
